# Copier en `.env` et renseigner la clé pour activer le cadrage par IA (Gemini).
# Clé gratuite : https://aistudio.google.com/apikey
# Sans clé, l'app fonctionne avec le moteur de cadrage local (heuristique).

EXPO_PUBLIC_GEMINI_API_KEY=
# Optionnel : modèle Gemini (défaut: gemini-2.5-flash)
# EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash
